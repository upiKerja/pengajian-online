<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - Kelas Belajar Ngaji Online</title>
    <meta name="description" content="{{description}}">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="css/page.css">
</head>
<body x-data="{auth: false, mdata: fetch_get_data()}">
    <!-- Loading Overlay -->
    <div id="loading" class="loading-overlay">
        <div class="loading-spinner"></div>
    </div>

    <!-- Header -->
    <div x-data="{ html:'' }"
        x-init="fetch('/src/assets/assets-pages/navbar-ngaji.html').then(r=>r.text()).then(t=>html=t)"
        x-html="html">
    </div>

    <!-- Hero Section -->
    <section class="hero-section islamic-pattern arabic-decoration">
        <div class="container">
            <div class="hero-content">
                <div class="hero-text">
                    <h2 class="hero-title" x-text="(await mdata).data.judul"></h2>
                    <p class="hero-description" x-text="(await mdata).data.deskripsi"></p>
                    <div class="hero-buttons">
                        <button class="btn-outline">
                            <i class="fas fa-book-open mr-2"></i> Lihat Pertemuan
                        </button>
                        <button @click="daftar_kelas((await mdata).data.id_kelas)" class="btn-primary">
                            <i class="fas fa-user-graduate mr-2"></i> Daftar Sekarang
                        </button>
                    </div>
                    
                    <div class="info-card">
                        <div class="info-card-content">
                            <div class="info-icon">
                                <i class="fas fa-info-circle text-xl"></i>
                            </div>
                            <div class="info-details">
                                <h4 class="info-title">Informasi Kelas</h4>
                                <div class="info-items">
                                    <div class="info-item">
                                        <i class="fas fa-users mr-2"></i>
                                        <span>120 Peserta</span>
                                    </div>
                                    <div class="info-item">
                                        <i class="fas fa-clock mr-2"></i>
                                        <span>12 Pertemuan</span>
                                    </div>
                                    <div class="info-item">
                                        <i class="fas fa-calendar-alt mr-2"></i>
                                        <span>Mulai 15 Juni</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="hero-image-container">
                    <div class="relative">
                        <img src="https://images.unsplash.com/photo-1564121211835-e88c852648ab?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80"
                             alt="Islamic Learning"
                             class="hero-image">
                        <div class="rating-badge">
                            <i class="fas fa-star mr-1"></i> 4.9 (120 Reviews)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Course Section -->
    <section class="section section-white">
        <div class="container">
            <!-- Donation Section -->
            <section class="section section-donation" x-data="{ donasi: {} }" 
                    x-init="fetch_donasi().then(r => donasi = r.data)">
                <div class="container">
                    <!-- Title -->
                    <div class="text-center mb-12">
                        <h2 class="section-title islamic-border islamic-border-center">Ayo Bersedekah</h2>
                        <p class="section-subtitle">
                            "Barangsiapa yang memberi pinjaman kepada Allah dengan pinjaman yang baik, 
                            maka Allah akan melipatgandakan balasan pinjaman itu untuknya 
                            dan dia akan memperoleh pahala yang mulia." (QS. Al-Hadid: 11)
                        </p>
                    </div>

                    <!-- Donation Card -->
                    <div class="donation-card">
                        <div class="donation-img">
                            <img src="https://images.unsplash.com/photo-1622206151226-18ca2c9ab4a1?ixlib=rb-4.0.3&auto=format&fit=crop&w=1470&q=80" 
                                alt="Sedekah Palestina">
                        </div>
                        <div class="donation-body">
                            <div class="donation-header">
                                <span class="donation-category">🌙 Palestina</span>
                                <h3 class="donation-title" x-text="donasi.nama_program"></h3>
                            </div>
                            
                            <p class="donation-description" x-text="donasi.deskripsi"></p>
                            
                            <!-- Progress -->
                            <div class="progress-wrapper">
                                <div class="progress-info">
                                    <span>Terkumpul</span>
                                    <span class="font-bold text-green">Rp 12.450.000</span>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: 65%"></div>
                                </div>
                            </div>

                            <!-- Button -->
                            <button class="donation-btn">
                                <i class="fas fa-hand-holding-heart mr-2"></i> Sedekah Sekarang
                            </button>
                        </div>
                    </div>
                </div>
            </section>
            
            <!-- Teacher Section -->
            <section class="teacher-section">
            <h3 class="teacher-title">
                <i class="fas fa-chalkboard-teacher mr-2"></i> Tentang Mentor
            </h3>

            <div class="teacher-card">
                <div class="teacher-content">
                
                <!-- Avatar -->
                <div class="teacher-avatar">
                    <img class="teacher-img" 
                        x-bind:src="(await mdata).data.pengguna.foto_url" 
                        alt="Foto Mentor">
                    <span class="teacher-verified">
                    <i class="fas fa-check text-xs"></i>
                    </span>
                </div>

                <!-- Info -->
                <div class="teacher-info">
                    <h4 class="teacher-name" x-text="(await mdata).data.pengguna.nama_lengkap"></h4>
                    <p class="teacher-specialty">Quran Specialist</p>
                    
                    <div class="teacher-rating">
                    <div class="stars">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star-half-alt"></i>
                    </div>
                    <span class="rating-count">4.8 (240 reviews)</span>
                    </div>
                    
                    <p class="teacher-bio">
                    Lulusan Universitas Al-Azhar dengan pengalaman mengajar lebih dari 10 tahun. 
                    Spesialis dalam ilmu Tajwid dan Tahsin.
                    </p>

                    <!-- Sosial Media -->
                    <div class="teacher-social">
                    <a href="#" class="social-icon" aria-label="WhatsApp">
                        <i class="fab fa-whatsapp"></i>
                    </a>
                    <a href="#" class="social-icon" aria-label="Telegram">
                        <i class="fab fa-telegram"></i>
                    </a>
                    <a href="mailto:email@example.com" class="social-icon" aria-label="Email">
                        <i class="fas fa-envelope"></i>
                    </a>
                    </div>
                </div>

                </div>
            </div>
            </section>
            
            <!-- Meetings Section -->
            <section class="meetings-section">
            <div class="meetings-header">
                <h3 class="meetings-title">
                <i class="fas fa-calendar-check mr-2"></i> Daftar Pertemuan
                </h3>
                <div class="meetings-count">
                <span class="font-medium">12</span> Pertemuan
                </div>
            </div>

            <div class="meetings-list">
                <!-- Meeting Items -->
                <template x-for="(pertemuan, index) in (await fetch_pertemuan((await mdata).data.id_kelas)).data">
                <div class="meeting-item">
                    <div class="meeting-content">
                    
                    <!-- Icon -->
                    <div class="meeting-icon">
                        <i class="fas fa-play-circle text-xl"></i>
                    </div>
                    
                    <!-- Details -->
                    <div class="meeting-details">
                        <div class="meeting-header">
                        <div>
                            <h4 class="meeting-title" x-text="pertemuan.judul"></h4>
                            <p class="meeting-description" x-text="pertemuan.deskripsi"></p>
                        </div>
                        </div>

                        <div class="meeting-meta">
                        <div class="meta-item">
                            <i class="fas fa-calendar-day mr-1"></i>
                            <span>15 Juni 2023</span>
                        </div>
                        <div class="meta-item">
                            <i class="fas fa-clock mr-1"></i>
                            <span>19:30 - 21:00 WIB</span>
                        </div>
                        </div>
                    </div>

                     <span class="meeting-number">
                            Pertemuan #<span x-text="index + 1"></span>
                    </span>
                    <button class="meeting-btn">
                        <i class="fas fa-video mr-1"></i> Join Kelas
                    </button>
                    </div>
                </div>
                </template>
            </div>

            <div class="text-center">
                <button class="view-all">
                Lihat Semua Pertemuan <i class="fas fa-chevron-down ml-2"></i>
                </button>
            </div>
            </section>
        </div>
    </section>

    <!-- Footer -->
    <div x-data="{ html:'' }"
        x-init="fetch('/src/assets/assets-pages/footer-ngaji.html').then(r=>r.text()).then(t=>html=t)"
        x-html="html">
    </div>

    <script>
        // Hide loading spinner when page is loaded
        window.addEventListener('load', function() {
            document.getElementById('loading').style.display = 'none';
        });
        
        // Mobile menu toggle
        document.addEventListener('alpine:init', () => {
            Alpine.data('mobileMenuOpen', false);
        });
        
        // Mock functions for demo purposes
        function fetch_get_data() {
            return Promise.resolve({
                data: {
                    judul: "Kelas Belajar Membaca Al-Quran dari Nol",
                    deskripsi: "Pelajari cara membaca Al-Quran dengan benar melalui metode yang mudah dipahami. Cocok untuk pemula yang ingin memulai perjalanan mengaji.",
                    id_kelas: 1,
                    thumbnail_url: "https://images.unsplash.com/photo-1564121211835-e88c852648ab?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80",
                    pengguna: {
                        foto_url: "https://randomuser.me/api/portraits/men/32.jpg",
                        nama_lengkap: "Ustadz Ahmad Fauzi"
                    }
                }
            });
        }
        
        function fetch_donasi() {
            return Promise.resolve({
                data: {
                    nama_program: "Bantu Pendidikan Anak Palestina",
                    deskripsi: "Bantu anak-anak Palestina mendapatkan pendidikan yang layak melalui program sedekah pendidikan ini. Setiap donasi akan digunakan untuk membiayai sekolah, buku, dan kebutuhan pendidikan lainnya."
                }
            });
        }
        
        function fetch_pertemuan(kelasId) {
            return Promise.resolve({
                data: [
                    {
                        judul: "Pengenalan Huruf Hijaiyah",
                        deskripsi: "Mengenal dan mempelajari huruf-huruf hijaiyah dasar dengan pengucapan yang benar."
                    },
                    {
                        judul: "Harakat Fathah, Kasrah, dan Dammah",
                        deskripsi: "Memahami dan mempraktikkan harakat dasar dalam membaca Al-Quran."
                    },
                    {
                        judul: "Praktik Membaca Kalimat Pendek",
                        deskripsi: "Mempraktikkan bacaan kalimat pendek dengan harakat yang telah dipelajari."
                    }
                ]
            });
        }
        
        function daftar_kelas(kelasId) {
            alert('Anda akan mendaftar kelas dengan ID: ' + kelasId);
        }
    </script>
</body>
</html>